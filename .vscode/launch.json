{
    "version": "0.1.0",
    "configurations": [
        {
            "name": "Main",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "API",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/Backend/api.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Agent",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/Agents/agents.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Server",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/Backend/server.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Website",
            "type": "pwa-node",
            "request": "launch",
            "cwd": "${workspaceFolder}/frontend",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["start"],
            "console": "integratedTerminal"
        }
        
    ],
    "compounds": [
        {
            "name": "Server+Main",
            "configurations": ["Server", "Main"],
            "stopAll": true
        },
        {
            "name": "Server+API",
            "configurations": ["Server", "API"],
            "stopAll": true
        },
        {
            "name": "Server+API+Main",
            "configurations": ["Server", "API", "Main"],
            "stopAll": true
        }
    ]
}