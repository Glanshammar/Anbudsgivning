{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.1.0",
    "configurations": [
        {
            "name": "Main",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal"
        },
        {
            "name": "API",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/API/api.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Agent",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/Agents/agent.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Agent - ZeroMQ",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/Agents/agent_zmq.py",
            "console": "integratedTerminal"
        },
    ],
    "compounds": [
        {
            "name": "Main+API",
            "configurations": ["Main", "API"],
            "stopAll": true
        }
    ]
}